{
  "name": "cirq",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api,legacy -c green,cyan,gray \"vite\" \"npm run dev:api\" \"npm run dev:legacy\"",
    "dev:web": "vite",
    "dev:api": ".venv/bin/python -m uvicorn backend.app.main:app --reload --port 8100",
    "dev:legacy": "tsx server/legacy.ts",
    "build": "vite build",
    "preview": "vite preview",
    "ingest": "python -m backend.scripts.ingest",
    "test:api": "pytest backend/tests",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "echarts": "^6.1.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^6.13.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "concurrently": "^9.0.0"
  }
}
