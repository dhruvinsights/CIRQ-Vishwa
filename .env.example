# Copy to .env (never commit it). Everything below is read by the Python backend.

# --- mode ---------------------------------------------------------------------------------------
AUTH_MODE=dev                       # dev | appext  (appext = NaLamKI Application SDK sign-in)
LEGACY_ENGINE_URL=http://127.0.0.1:3001

# --- AgriFoodData digital farm API ---------------------------------------------------------------
FARM_API_BASE_URL=                  # e.g. https://<deployment-host>/v1  (ask your platform operator)
FARM_API_TOKEN=                     # dev only. In appext mode tokens come from token exchange.

# --- Db2 vector store (needs Db2 >= 12.1.2) ------------------------------------------------------
DB2_DATABASE=
DB2_HOST=
DB2_PORT=50000
DB2_USERNAME=
DB2_PASSWORD=
DB2_SECURITY=false                  # true for SSL
DB2_RAG_TABLE=CIRQ_KNOWLEDGE
RAG_MAX_DISTANCE=0.65               # tune on real data
RAG_TOP_K=5

# --- LLM / embeddings -----------------------------------------------------------------------------
# Recommended for production / offline / on-premise: ollama
LLM_PROVIDER=ollama                 # ollama | gemini | watsonx

# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# Optional Google Gemini configuration
# GEMINI_API_KEY=
# EMBEDDING_MODEL=models/gemini-embedding-001
# CHAT_MODEL=gemini-2.5-flash

# Optional IBM watsonx configuration
# WATSONX_URL=
# WATSONX_APIKEY=
# WATSONX_PROJECT_ID=
# WATSONX_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr-v2
# WATSONX_CHAT_MODEL=ibm/granite-3-8b-instruct

# --- misc ---------------------------------------------------------------------------------------------
CORPUS_DIR=backend/corpus
VITE_CARTO_API_KEY=cb1_4dig_1_15be51a493481a952ce6d256
# VITE_MAP_STYLE_URL=               # optional MapLibre style URL
# STA_BASE_URL=                     # optional OGC SensorThings base URL
